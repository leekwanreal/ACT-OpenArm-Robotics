<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>openarm_smolvla</name>
  <version>0.1.0</version>
  <description>Runs a SmolVLA policy on OpenArm: openarm_act's node, asking an openarm_smolvla server for each chunk over websocket, published as the smolvla command source.</description>
  <maintainer email="nguyentoan10601@gmail.com">nguyenton</maintainer>
  <license>Apache-2.0</license>

  <!-- The node is openarm_act's ActNode under another name. -->
  <exec_depend>openarm_act</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-msgpack</exec_depend>
  <exec_depend>python3-websockets</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
