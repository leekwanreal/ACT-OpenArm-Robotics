# Meshes and other binaries go to Git LFS. They are most of this repository by
# size -- the URDF visual meshes alone are tens of megabytes -- and they never
# diff usefully, so keeping them out of the history's packfiles makes clones
# and fetches far cheaper.
#
# After cloning, `git lfs pull` fetches them. A clone without git-lfs installed
# gets small pointer files instead of meshes, and the 3D view will not load.

*.dae filter=lfs diff=lfs merge=lfs -text
*.stl filter=lfs diff=lfs merge=lfs -text
*.obj filter=lfs diff=lfs merge=lfs -text
*.mtl filter=lfs diff=lfs merge=lfs -text

*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text

# Keep text as text, with newlines that do not churn across platforms.
*.py text
*.js text
*.xml text
*.yaml text
*.md text
*.sh text eol=lf
